N = int(input())
for _ in range(N):
    M = int(input())
    if M <= 1:
        continue
    is_prime = True
    for i in range(2,int(M ** 0.5) + 1):
        if M % i == 0 :
            is_prime = False
            break
    if is_prime:
        print(M)
        break
else:
    print("not a print number")
