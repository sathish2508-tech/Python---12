S = input()
value = float(S[:-1])
unit = S[-1]
C = F = K = 0
if unit == "C":
    C = value
    F = (C * 9 / 5) + 32
    K = C + 273
elif unit == "F":
    F = value
    C = (F - 32) * 5 / 9
    K = C + 273
else:
    K = value
    C = K - 273
    F = (C * 9 / 5) + 32
C = round(C,2)
F = round(F,2)
K = round(K,2)
print(str(C) + "C")
print(str(F) + "F")
print(str(K) + "K")
